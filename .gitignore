# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Game data must never be committed. The tools ship no game bytes.
*.exe
*.dll
*.WLD
*.wld
*.bin
*.cue
*.iso
*.img
*.mdf
*.mds
*.ccd
*.DAT
*.dat
*.WAV
*.wav
*.mid
*.MID
GAME.TXT
LOMAX.HLP
LOMAX.CNT
LOMAX.GID
WORLDS/
SFX/
DEMOS/
JINGLES/
AMBIENT/
MUSIC/

# Local notes / captures
*.log
LOADER.LOG
.scratch/
# Default output of examples/demo.sh: engine renders of the viewer's own copy,
# produced locally and never committed.
demo-out/

# Local game-data slots (docs/development.md). Kept outside the repository in
# practice; ignored anyway so a copy can never be committed by accident.
game-files/
gamedata/
GAMES/

# Git worktrees the kanban dispatcher creates inside the checkout
# (<repo>/.worktrees/<task-id>) for worktree-kind cards.
.worktrees/

# Native renderer build artifacts (built in CI only, never committed)
native/smoke
native/*.o
